# 生产环境配置文件
# 部署前务必修改所有密码和密钥！

# 数据库配置
MYSQL_ROOT_PASSWORD=Change_This_Strong_Password_123456!
DATABASE_URL=mysql+pymysql://root:Change_This_Strong_Password_123456!@db:3306/emotion_legacy_db

# JWT配置（使用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成）
SECRET_KEY=Change_This_To_Random_String_At_Least_32_Characters_Long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 应用配置
APP_NAME=Emotion Legacy API
DEBUG=False
API_VERSION=v1

# CORS配置（修改为你的域名）
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# 微信登录配置（如果使用）
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
